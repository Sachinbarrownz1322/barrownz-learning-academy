# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# 1. Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# 2. Next.js & Production Build Outputs
.next/
out/
build/
dist/

# 3. Environment Variables & Secret Keys (Crucial for Security)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
.env.example
*.pem
*.key
*.cert

# 4. Debug & Runtime Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# 5. Diagnostic, Vercel & Turbo Cache
.vercel/
.turbo/
.cache/

# 6. Testing, Coverage & Reports
coverage/
*.lcov
.nyc_output/
cypress/videos/
cypress/screenshots/

# 7. IDE & Code Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# 8. Operating System Specific Files
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# 9. Temporary & Backup Files
*.bak
*.tmp
*.temp
tmp/
temp/
